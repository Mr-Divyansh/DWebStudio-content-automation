# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or local .env file.
GEMINI_API_KEY=""
# 👆 Sabse jaruri key. https://aistudio.google.com/app/apikey se free key
# lekar yahan paste karo. Bina iske AI demo mode me chalegi (rukege nahi).

# Bounded Gemini request controls (optional; safe defaults are used when blank).
GEMINI_MODEL=""
GEMINI_TIMEOUT_MS=""
GEMINI_MAX_RETRIES=""

# DATABASE_URL: Prisma connection string (the committed schema uses postgresql).
#   Local development (with the SQLite override): file:./dev.db
#   Vercel production: a PostgreSQL connection string, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#   Set the real value ONLY in the Vercel dashboard. Never commit it.
DATABASE_URL=""

# Production operator authentication. Leave blank only for local development.
DWS_ADMIN_PASSWORD=""
DWS_SESSION_SECRET=""

# Vercel Cron authentication for the durable follow-up endpoint.
CRON_SECRET=""

# Server Port
PORT="3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ============================================================================
# MESSAGING PROVIDER (official APIs only)
# ============================================================================
# Which adapter the autonomous agent uses.
#   dry_run   -> no network calls; messages are prepared and logged only (SAFE DEFAULT)
#   instagram -> official Meta Instagram Messaging API
# Any other value falls back to dry_run.
MESSAGING_PROVIDER=""

# Optional public-business discovery defaults (the operator can also change these in the dashboard).
SEED_DEMO_DATA=""
PUBLIC_DISCOVERY_ENABLED=""
PUBLIC_DISCOVERY_CITY=""
PUBLIC_DISCOVERY_NICHES=""
PUBLIC_DISCOVERY_LIMIT="3"

# --- Meta Instagram Messaging API (required only when MESSAGING_PROVIDER=instagram)
# Setup requirements before these work:
#   1. Instagram account must be PROFESSIONAL (Business or Creator) — personal
#      accounts cannot use the messaging API.
#   2. Link that Instagram account to a Facebook Page.
#   3. Create a Meta app and add the "Messenger > Instagram Messaging" product.
#   4. Obtain the `instagram_manage_messages` permission.
#   5. App Review / Advanced Access is required to message people who do not have
#      a role on the app.
#
# META_PAGE_ACCESS_TOKEN: Page access token for the linked Facebook Page.
#   Keep it ONLY in your local .env. Never commit it or paste it into chat.
META_PAGE_ACCESS_TOKEN=""

# META_PAGE_ID: Numeric Facebook Page ID linked to the Instagram professional account.
META_PAGE_ID=""

# META_GRAPH_API_VERSION: Pinned Graph API version. Leave blank for the default.
META_GRAPH_API_VERSION=""

# META_GRAPH_MAX_RETRIES: Retry attempts for rate limits / 5xx faults (0-5).
META_GRAPH_MAX_RETRIES="3"

# META_IG_MAX_TEXT_BYTES: Max message size in bytes (Meta documents 1000 bytes).
META_IG_MAX_TEXT_BYTES="1000"

# --- Meta Webhook (required to RECEIVE replies) ------------------------------
# META_APP_SECRET: App secret from your Meta App > Settings > Basic.
#   Used ONLY to verify the X-Hub-Signature-256 header. Never sent to Meta.
META_APP_SECRET=""

# META_WEBHOOK_VERIFY_TOKEN: Any random string you choose. You enter the same
#   value in the Meta webhook dashboard; Meta sends it back during verification.
META_WEBHOOK_VERIFY_TOKEN=""

# Webhook callback URL to register in Meta (must be publicly reachable HTTPS):
#   https://<your-public-host>/api/webhooks/instagram
# Subscribe these fields: messages, messaging_postbacks, message_reads, message_reactions
#
# ALSO REQUIRED IN INSTAGRAM SETTINGS (not in the API dashboard):
#   Instagram Settings > Messages and story replies > Message controls >
#   Connected Tools > toggle "Allow Access to Messages"
#
# IMPORTANT PLATFORM LIMITATIONS (not configurable here):
#   - Meta requires the recipient's Instagram-scoped ID (IGSID), not an @username.
#     An IGSID is only issued to someone who messaged your business or through an
#     approved Meta flow, so researched leads that only have a handle CANNOT be
#     messaged through the official API.
#   - Proactive/cold outreach to accounts that have never interacted is NOT
#     permitted by the official API. The adapter refuses rather than guessing and
#     never falls back to browser automation or session scraping.

# IMPORTANT LIMITATION (not configurable here):
#   Meta requires the recipient's Instagram-scoped ID (IGSID), not an @username.
#   An IGSID is only issued to someone who messaged your business or through an
#   approved Meta flow, so researched leads that only have a handle CANNOT be
#   messaged through the official API. The adapter refuses rather than guessing
#   and never falls back to browser automation or session scraping.

# ============================================================================
# APPLICATION LOGIN (normal users)
# ============================================================================
# There are NO user-facing secrets in this section. A normal user creates an
# account with an email and a password on the login screen; passwords are
# hashed with scrypt and sessions are stored server-side. The values below are
# for the administrator only.
#
# DWS_TOKEN_ENCRYPTION_KEY: REQUIRED to connect WhatsApp/Discord/Telegram.
#   At least 32 characters. Platform authorization tokens are encrypted with
#   AES-256-GCM under this key before being stored, and are only ever decrypted
#   on the server. If it is blank, connections are correctly reported as
#   unavailable instead of storing a token under a weak key.
#   Generate one with:  openssl rand -base64 48
#   Never commit it. Rotating it invalidates every stored connection token, so
#   users must reconnect their accounts afterwards.
DWS_TOKEN_ENCRYPTION_KEY=""

# ============================================================================
# PLATFORM CONNECTIONS — ONE-TIME DEVELOPER/ADMIN SETUP
# ============================================================================
# A normal user NEVER fills in anything in this section. It is configured once
# by the D Web Studio administrator so that every customer can then connect
# their own account with a single button.
# Full walkthrough: docs/CONNECTED_ACCOUNTS.md

# --- Discord (OAuth2 Authorization Code + PKCE) -----------------------------
# Setup: Discord Developer Portal -> New Application -> OAuth2 -> add the
# redirect URI `${APP_URL}/api/connections/discord/callback`.
# Scopes requested: identify, email (no message-sending permission).
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Telegram (official Login Widget) ---------------------------------------
# Setup: create a bot with @BotFather, then send /setdomain with this app's
# domain so Telegram will render the login button.
# The bot TOKEN is used ONLY on the server to verify the widget's HMAC
# signature. It is never sent to the browser, and no Telegram password or
# phone-number code is ever requested or stored. Connecting proves identity
# only; sending still requires a separately configured bot.
TELEGRAM_BOT_ID=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_BOT_TOKEN=""

# --- WhatsApp (Meta Embedded Signup for the WhatsApp Business Platform) -----
# IMPORTANT: WhatsApp is connected through Meta's official Embedded Signup, NOT
# a WhatsApp Web QR session. QR automation, cookie extraction and unofficial
# clients are not implemented and must not be added: they violate WhatsApp's
# terms, risk permanently banning the business number, and cannot ship.
#
# Setup: become a Meta Tech Provider, add the WhatsApp product, apply for
# Advanced Access on whatsapp_business_management + whatsapp_business_messaging,
# then create a Facebook Login for Business configuration using the Embedded
# Signup variation and copy its configuration id.
#
# Until Meta approves the app, WhatsApp shows as "not available yet" rather than
# pretending to connect. Users are never asked for a phone id or a token.
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""

# Meta Graph API version used for the WhatsApp exchange and verification calls.
META_GRAPH_API_VERSION="v21.0"
# --- Instagram (Facebook Login for Business for Instagram) -------------------
# Instagram is connected through Meta's official Instagram Platform, which
# supports ONLY professional accounts (Instagram Business or Creator) linked to
# a Facebook Page. The user authorizes on Meta's own screens; no Instagram
# password, cookie or session is ever collected by this application.
#
# META_APP_ID / META_APP_SECRET are shared with the WhatsApp integration above.
# Optional but recommended: a Facebook Login for Business configuration id that
# enables Meta's Embedded Signup popup (the same smooth UX as WhatsApp).
# If META_INSTAGRAM_CONFIG_ID is blank, the app falls back to Meta's standard
# Facebook OAuth dialog redirect, which only needs the app id and secret.
#
# Permissions to request Advanced Access for:
#   instagram_basic, pages_show_list, instagram_manage_messages,
#   business_management
META_INSTAGRAM_CONFIG_ID=""

# --- Gmail (Google OAuth 2.0) -----------------------------------------------
# Setup: Google Cloud Console -> create a project -> enable the Gmail API ->
# Credentials -> OAuth client ID -> "Web application".
# Authorized redirect URI (exact):
#   ${APP_URL}/api/connections/gmail/callback
#
# Scopes requested by this application (minimum only):
#   https://www.googleapis.com/auth/gmail.readonly   read messages/threads
#   https://www.googleapis.com/auth/userinfo.email  show the account address
#   openid                                          identity verification
# gmail.send / gmail.modify are deliberately NOT requested because the app does
# not send mail yet. Add them only when sending is implemented.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
