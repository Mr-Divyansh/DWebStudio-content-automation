{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/agent",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/follow-ups",
      "schedule": "0 * * * *"
    }
  ]
}
