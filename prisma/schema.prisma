// Prisma datasource for PRODUCTION (Vercel / PostgreSQL).
//
// Why postgresql is the committed default: Prisma does not allow env() in the
// `provider` argument (P1012), so the committed schema must name a concrete
// provider. Production needs a persistent, serverless-safe database, and the
// local SQLite file `prisma/dev.db` is neither persistent nor deployable.
//
// Local development without PostgreSQL is still supported through a separate
// schema file that is swapped in only by the `dev:*` npm scripts:
//   prisma/schema.sqlite.prisma  (datasource provider = "sqlite")
//
// Nothing in this file is destructive; `prisma/dev.db` remains git-ignored and
// existing local data is preserved.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id                   String          @id @default(cuid())
  businessName         String          @default("UNKNOWN")
  personName           String          @default("UNKNOWN")
  instagramUsername    String?
  phone                String?
  email                String?
  location             String          @default("UNKNOWN")
  website              String          @default("UNKNOWN")
  niche                String          @default("UNKNOWN")
  source               String          @default("INSTAGRAM")
  sourceConversationId String?
  conversationSummary  String?
  intent               String          @default("UNKNOWN")
  interestLevel        String          @default("UNKNOWN")
  status               String          @default("NEW")
  qualification        String          @default("PENDING_INFO")
  qualificationReason  String?
  offerDiscussed       String?
  priceDiscussed       String?
  objections           String?         // Stored as JSON string
  importantMessages    String?         // Stored as JSON string
  followUpNeeded       Boolean         @default(false)
  followUpReason       String?
  portfolioMatch       String          @default("NO_MATCH")
  suggestedNextAction  String?
  confidence           String          @default("LOW")
  opportunityScore     Int             @default(0)
  opportunitySegment   String          @default("UNSCORED") // HOT | WARM | REVIEW | COLD | UNSCORED
  scoreBreakdown       String?         // JSON array of deterministic score contributions
  evidence                   String?         // Stored as JSON string
  notes                      String?
  // Autonomous agent (additive, nullable/flag-only — never deletes existing data).
  // aiPaused=true means a human took over this conversation: the AI must not message the lead.
  aiPaused                   Boolean         @default(false)
  doNotContact               Boolean         @default(false)
  optOutAt                   DateTime?
  // Instagram-scoped ID (IGSID) for the official Meta Messaging API. A @username
  // is NOT enough: Meta only issues an IGSID to a person who messaged the business
  // (or via an approved Meta flow), so this stays null for most researched leads.
  instagramScopedId          String?         @unique
  // Set only after a verified inbound Meta webhook binds this IGSID to the lead.
  // It prevents researched/cold leads from being treated as authorized conversations.
  messagingAuthorizedAt      DateTime?
  facebookPageUrl             String?
  publicDiscoverySource       String?
  lastInboundAt              DateTime?
  lastOutboundAt             DateTime?
  followUpAttempts           Int             @default(0)
  followUpMaxAttempts        Int             @default(1)
  followUpNextAt             DateTime?
  conversationStage          String          @default("NEW")
  lastAgentActionAt          DateTime?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  conversations        Conversation[]
  analyses             Analysis[]
  corrections          Correction[]
  outreachDrafts       OutreachDraft[]
  evidenceItems        Evidence[]
  learnings            Learning[]
  researchRecords      BusinessResearch[]
  qualifications       LeadQualification[]
  agentEvents          AgentEvent[]
  outboundMessages     OutboundMessage[]
  learningEvents       LearningEvent[]
  inboundMessages      InboundMessage[]

  @@index([status])
  @@index([intent])
  @@index([source])
  @@index([niche])
  @@index([instagramUsername])
}

model Conversation {
  id               String    @id @default(cuid())
  externalId       String    @unique
  source           String    @default("INSTAGRAM")
  title            String    @default("Untitled Conversation")
  participantNames String?   // Stored as JSON string array
  messageCount     Int       @default(0)
  rawMetadata      String?   // Stored as JSON string
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  importId         String?
  importRecord     Import?   @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages         Message[]
  analyses         Analysis[]

  @@index([externalId])
  @@index([source])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          String
  senderType      String       @default("UNKNOWN") // USER, CLIENT, UNKNOWN
  content         String
  timestamp       DateTime     @default(now())
  sourceMessageId String?
  metadata        String?      // JSON string

  @@index([conversationId])
  @@index([timestamp])
}

model Analysis {
  id                  String        @id @default(cuid())
  leadId              String?
  lead                Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId      String?
  conversation        Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  intent              String        @default("UNKNOWN")
  intentReason        String?
  intentConfidence    String        @default("LOW")
  qualification       String        @default("PENDING_INFO")
  qualificationReason String?
  objections          String?       // JSON string
  portfolioMatched    String        @default("NO_MATCH")
  suggestedAction     String?
  evidenceList        String?       // JSON string
  conversationStage   String?       // NEW | QUALIFYING | INTERESTED | REQUIREMENTS | PRICING | ...
  needsHuman          Boolean       @default(false)
  needsRequirements   Boolean       @default(false)
  asksPricing         Boolean       @default(false)
  purchaseIntent      Boolean       @default(false)
  rawAiResponse       String?       // JSON string
  createdAt           DateTime      @default(now())

  @@index([leadId])
  @@index([conversationId])
}

model Learning {
  id           String    @id @default(cuid())
  learning     String
  type         String    // OBJECTION_PATTERN, PRICING_SIGNAL, NICHE_BEHAVIOR, SUCCESS_FACTOR, REJECTION_REASON
  evidence     String?   // JSON string array
  confidence   String    @default("MEDIUM")
  appliesTo    String    @default("General")
  source       String    @default("CONVERSATION_ANALYSIS")
  relatedLeadId String?
  relatedLead  Lead?     @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([type])
  @@index([appliesTo])
}

model Import {
  id                 String         @id @default(cuid())
  source             String         @default("INSTAGRAM")
  fileName           String
  filePath           String?
  status             String         @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  filesDiscovered    Int            @default(0)
  supportedFiles     Int            @default(0)
  unsupportedFiles   Int            @default(0)
  conversationCount  Int            @default(0)
  messageCount       Int            @default(0)
  leadCount          Int            @default(0)
  errors             String?        // JSON string array
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  conversations      Conversation[]

  @@index([source])
  @@index([status])
}

model Correction {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field          String
  originalValue  String
  correctedValue String
  userReason     String?
  createdAt      DateTime  @default(now())

  @@index([leadId])
}

model PortfolioProject {
  id           String    @id @default(cuid())
  title        String
  category     String
  description  String
  technologies String?
  results      String?
  liveUrl      String?
  keyFeatures  String?
  createdAt    DateTime  @default(now())

  @@index([category])
}

model OutreachDraft {
  id                    String    @id @default(cuid())
  leadId                String
  lead                  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel               String    @default("INSTAGRAM_DM") // INSTAGRAM_DM, WHATSAPP, EMAIL
  subject               String?
  messageBody           String
  personalizationReason String?
  evidenceUsed          String?   // JSON string array
  confidence            String    @default("MEDIUM")
  status                String    @default("DRAFTED") // DRAFTED, APPROVED, REJECTED, SENT
  approvedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([leadId])
  @@index([status])
}

model Evidence {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  claim        String
  evidence     String
  source       String
  confidence   String    @default("MEDIUM")
  // Added in Phase 1 (P1): additive, nullable columns so existing conversation evidence is untouched.
  sourceUrl    String?
  observation  String?
  fetchedAt    DateTime?
  evidenceType String? // OBSERVED_FACT, OBSERVED_ABSENCE, UNREACHABLE, NOT_EVALUATED, AI_INFERENCE
  createdAt    DateTime  @default(now())

  @@index([leadId])
  @@index([evidenceType])
}

// Phase 1 (P1) — structured record of one human-triggered public research run for a lead.
// Fields are explicit columns (never one giant AI text blob) and every non-null value is backed by
// an Evidence row carrying sourceUrl + fetchedAt + evidenceType. Nullable everywhere: "unknown"
// stays null instead of being guessed.
model BusinessResearch {
  id                      String   @id @default(cuid())
  leadId                  String
  lead                    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  targetUrl               String
  finalUrl                String?
  status                  String   @default("COMPLETED") // COMPLETED, PARTIAL, FAILED
  source                  String   @default("PUBLIC_WEBSITE")
  reachable               Boolean  @default(false)
  httpStatus              Int?
  statusText              String?
  httpsAvailable          Boolean?
  httpsStatus             Int?
  httpsError              String?
  responseTimeMs          Int?
  redirectCount           Int      @default(0)
  title                   String?
  metaDescription         String?
  canonicalUrl            String?
  language                String?
  viewportMetaPresent     Boolean?
  viewportMetaContent     String?
  h1Count                 Int?
  h1Text                  String?
  imageCount              Int?
  imagesMissingAlt        Int?
  robotsTxtPresent        Boolean?
  bookingLinkDetected     Boolean?
  bookingLinks            String? // JSON string array
  contactLinkDetected     Boolean?
  contactLinks            String? // JSON string array
  emailLinks              String? // JSON string array (public mailto addresses only)
  phoneLinks              String? // JSON string array (public tel numbers only)
  socialLinks             String? // JSON string array of { platform, url }
  structuredDataTypes     String? // JSON string array
  businessName            String?
  businessType            String?
  category                String?
  location                String?
  publicEmail             String?
  publicPhone             String?
  services                String? // JSON string array
  observations            String? // JSON string array of deterministic observation strings
  // Phase 3 (P3): true when the public response was a bot-protection / access-denied page
  // (e.g. HTTP 403). Content from such a page never becomes a business claim.
  blocked                Boolean? // true = BLOCKED response, HTML/business checks not evaluated
  aiSummaryUsed           Boolean  @default(false)
  aiConfidence            String?
  warnings                String? // JSON string array
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([leadId, targetUrl])
  @@index([leadId])
  @@index([status])
}

// Phase 3 (P3) — deterministic, evidence-based lead qualification result.
// Every row is one human-triggered run; older rows are kept as history (never overwritten).
// `reasons` is a JSON array of { ruleId, type, reason, evidenceIds[] } so every factual reason
// is traceable to Evidence rows; no reason exists without supporting evidence.
model LeadQualification {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status         String   @default("NEEDS_REVIEW") // QUALIFIED, NOT_QUALIFIED, NEEDS_REVIEW
  confidence     String   @default("LOW") // HIGH, MEDIUM, LOW (deterministic from evidence completeness)
  reasons        String   @default("[]") // JSON string array of structured reason objects
  portfolioMatch String   @default("null") // JSON string: { project, reason, confidence } (project may be null)
  nextAction     String
  score           Int      @default(0)
  segment         String   @default("UNSCORED")
  scoreBreakdown  String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// AUTONOMOUS AGENT FOUNDATION (additive models — nothing existing is replaced)
// The agent reuses the existing pipeline (ResearchService -> QualificationService
// -> LeadService.generateOutreachDraft -> ConversationAnalyzer) and only records
// its own control state, activity, outbound log and structured learning.
// ============================================================================

// Singleton control row (id is always "singleton") holding the [START/PAUSE/STOP]
// state, AUTO DM switch, safety limits and the counters shown in the UI.
model AgentConfig {
  id                 String   @id @default("singleton")
  state              String   @default("STOPPED") // STOPPED | RUNNING | PAUSED
  autoDm             Boolean  @default(false) // OFF by default: no send adapter is connected
  maxSendsPerHour    Int      @default(10)
  maxSendsPerLead    Int      @default(1)
  followUpDelayHours Int      @default(72)
  tickIntervalMs     Int      @default(15000)
  batchSize          Int      @default(3)
  discoveryEnabled   Boolean  @default(false)
  discoveryCity      String?
  discoveryNiches    String   @default("[]") // JSON array of target categories
  discoveryLimit     Int      @default(3)
  lastDiscoveryAt    DateTime?
  lastDiscoveryKey   String   @default("")
  currentTask        String?
  lastAction         String?
  nextAction         String?
  leadsProcessed     Int      @default(0)
  messagesSent       Int      @default(0)
  repliesReceived    Int      @default(0)
  interested         Int      @default(0)
  notInterested      Int      @default(0)
  personalWork       Int      @default(0)
  humanRequired      Int      @default(0)
  failed             Int      @default(0)
  noResponse         Int      @default(0)
  closed             Int      @default(0)
  startedAt          DateTime?
  pausedAt           DateTime?
  stoppedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Real, timestamped activity for the agent. `details` is a JSON string and must
// never contain private Instagram message bodies.
model AgentEvent {
  id        String   @id @default(cuid())
  type      String // RUN_STARTED | RESEARCH_COMPLETED | QUALIFIED | DRAFT_CREATED | SEND_BLOCKED | ...
  status    String   @default("INFO") // INFO | SUCCESS | WARNING | ERROR | HUMAN_REQUIRED
  message   String
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  details   String? // JSON string
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([leadId])
}

// Outbound log. status is SENT only when a real provider confirmed delivery;
// otherwise DRY_RUN (adapter missing), BLOCKED (safety gate) or FAILED.
model OutboundMessage {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel     String   @default("INSTAGRAM_DM")
  recipient   String?
  body        String
  contentHash String
  status      String   @default("DRY_RUN") // SENT | DRY_RUN | BLOCKED | FAILED
  provider    String   @default("NONE")
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([contentHash])
}

// Inbound message from the official provider webhook. Stores only what is needed
// to identify, de-duplicate and display a reply. NEVER stores credentials.
// providerMessageId is unique so a redelivered webhook is idempotent.
model InboundMessage {
  id                String   @id @default(cuid())
  leadId            String?
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  channel           String   @default("INSTAGRAM_DM")
  provider          String   @default("META_INSTAGRAM_MESSAGING")
  providerMessageId String   @unique
  senderIgSid       String
  body              String
  direction         String   @default("INBOUND")
  deliveryStatus    String   @default("RECEIVED") // RECEIVED | IGNORED_ECHO | DUPLICATE
  humanTakeover     Boolean  @default(false)
  error             String?
  createdAt         DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([senderIgSid])
}

// Owner-editable pricing bounds. The agent may only choose a price inside
// [minPrice, maxNegotiation]; anything else escalates to a human.
model PricingRule {
  id              String   @id @default(cuid())
  service         String   @unique
  currency        String   @default("INR")
  minPrice        Int
  normalPriceMin  Int
  normalPriceMax  Int
  maxNegotiation  Int
  escalationAbove Int?
  active          Boolean  @default(true)
  packageName           String?
  includedItems         String?
  deliveryEstimate      String?
  advancePayment        String?
  revisions             String?
  optionalExtras        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Structured learning. One interaction is never a permanent rule: rows start as
// PROPOSED and only a human can promote them.
model LearningEvent {
  id                String   @id @default(cuid())
  sourceType        String // AUTONOMOUS_RUN | HUMAN_CORRECTION | REPLY_ANALYSIS | PRICING_OUTCOME
  sourceId          String?
  category          String // OUTREACH_STYLE | QUALIFICATION | REPLY_ANALYSIS | PRICING
  observation       String
  humanAction       String?
  evidence         String?   // JSON string array; never message bodies
  outcome           String?
  status            String   @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | ARCHIVED
  supportCount      Int      @default(1)
  contradictionCount Int      @default(0)
  leadId            String?
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category, status])
  @@index([leadId])
}
